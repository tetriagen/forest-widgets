{
  "font-family": {
    "type": "combobox",
    "default": "monocraft",
    "description": "Шрифт",
    "options": {
      "Системный": "system",
      "JetBrains Mono (установлен)": "mono",
      "Tiny5 (нужна установка)": "tiny5",
      "Press Start 2P (нужна установка)": "press",
      "Monocraft (установлен)": "monocraft"
    }
  },
  "opacity": {
    "type": "scale",
    "default": 55,
    "min": 40,
    "max": 100,
    "step": 1,
    "description": "Непрозрачность карточки, %"
  },
  "spin-enabled": {
    "type": "switch",
    "default": true,
    "description": "Вращать пластинку во время музыки"
  },
  "spin-seconds": {
    "type": "spinbutton",
    "default": 18,
    "min": 6,
    "max": 60,
    "step": 1,
    "description": "Секунд на один оборот"
  },
  "compact": {
    "type": "switch",
    "default": false,
    "description": "Компактный режим без пластинки"
  },
  "show-album": {
    "type": "switch",
    "default": true,
    "description": "Показывать название альбома"
  },
  "size-percent": {
    "type": "scale",
    "default": 100,
    "min": 75,
    "max": 160,
    "step": 5,
    "description": "Размер виджета, %"
  }
}