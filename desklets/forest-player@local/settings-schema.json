{
  "appearance": {
    "type": "combobox",
    "default": "radial",
    "description": "Внешний вид плеера",
    "options": {
      "Полукруг у края экрана": "radial",
      "Лесная пластинка (классический)": "vinyl"
    }
  },
  "spectrum-enabled": {
    "type": "switch",
    "default": true,
    "description": "Эквалайзер системного звука (нужен parec)"
  },
  "font-family": {
    "type": "combobox",
    "default": "doto",
    "description": "Шрифт",
    "options": {
      "Системный": "system",
      "JetBrains Mono (установлен)": "mono",
      "Tiny5 (нужна установка)": "tiny5",
      "Press Start 2P (нужна установка)": "press",
      "Monocraft (установлен)": "monocraft",
      "Manrope (установлен)": "manrope",
      "Doto — точечный": "doto"
    }
  },
  "opacity": {
    "type": "scale",
    "default": 55,
    "min": 40,
    "max": 100,
    "step": 1,
    "description": "Непрозрачность классической карточки, %"
  },
  "spin-enabled": {
    "type": "switch",
    "default": true,
    "description": "Вращать пластинку в классическом режиме"
  },
  "spin-seconds": {
    "type": "spinbutton",
    "default": 18,
    "min": 6,
    "max": 60,
    "step": 1,
    "description": "Секунд на один оборот"
  },
  "compact": {
    "type": "switch",
    "default": false,
    "description": "Компактный режим без пластинки"
  },
  "show-album": {
    "type": "switch",
    "default": false,
    "description": "Показывать название альбома"
  },
  "size-percent": {
    "type": "scale",
    "default": 100,
    "min": 75,
    "max": 160,
    "step": 5,
    "description": "Размер виджета, %"
  },
  "dock-side": {
    "type": "combobox",
    "default": "right",
    "description": "Край экрана для круглого плеера",
    "options": {
      "Слева": "left",
      "Справа": "right"
    }
  }
}
